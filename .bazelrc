build -c opt --cxxopt='-std=c++23'

# OpenCL configuration
# Use --config=opencl to enable OpenCL features
build:opencl --define=opencl=true
build:opencl --cxxopt='-std=c++23'

# AddressSanitizer configuration
build:asan --strip=never
build:asan --copt -fsanitize=address
build:asan --copt -DADDRESS_SANITIZER
build:asan --copt -O1
build:asan --copt -g
build:asan --copt -fno-omit-frame-pointer
build:asan --linkopt -fsanitize=address

# Common configurations
build --verbose_failures

build --repo_env=LLVM_VERSION=22
build --repo_env=SYSROOT_DIST=linux_glibc_2_27
build --@rules_ml_toolchain//common:enable_rocm=False
build --@rules_ml_toolchain//common:enable_cuda=False
build --@rules_ml_toolchain//common:enable_sycl=False
build --@rules_ml_toolchain//common:enable_hermetic_cc=True
build --@rules_ml_toolchain//common:enable_hermetic_libraries=True

