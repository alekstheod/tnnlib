module(
    name = "tnnlib",
    version = "0.1.0",
    repo_name = "tnnlib",
)

# Core BCR dependencies
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.0.17")
bazel_dep(name = "rules_license", version = "1.0.0")

# BCR third-party dependencies
bazel_dep(name = "catch2", version = "3.12.0")
bazel_dep(name = "zlib", version = "1.3.1.bcr.5")
bazel_dep(name = "libpng", version = "1.6.47.bcr.1")
bazel_dep(name = "cereal", version = "1.3.2.bcr.3")
bazel_dep(name = "range-v3", version = "0.12.0")

# Boost (non-BCR, using archive_override)
bazel_dep(name = "rules_boost", repo_name = "com_github_nelhage_rules_boost")
archive_override(
    module_name = "rules_boost",
    strip_prefix = "rules_boost-master",
    urls = "https://github.com/nelhage/rules_boost/archive/refs/heads/master.tar.gz",
)

# Boost repositories extension
non_module_boost_repositories = use_extension("@com_github_nelhage_rules_boost//:boost/repositories.bzl", "non_module_dependencies")
use_repo(
    non_module_boost_repositories,
    "boost",
)

# rules_ml_toolchain provides hermetic LLVM and ROCm toolchains
# Using git_override to get ROCm support from main branch
# Patch adds missing sysroot repos to use_repo list for Bzlmod compatibility
bazel_dep(name = "rules_ml_toolchain")
git_override(
    module_name = "rules_ml_toolchain",
    commit = "f4aabf8dd5c6f89192b52d4e648d96d4c44bce40",
    remote = "https://github.com/google-ml-infra/rules_ml_toolchain.git",
    patches = [
        "//third_party/rules_ml_toolchain:add_missing_use_repos.patch",
        "//third_party/rules_ml_toolchain:condition_rocm_download.patch",
        "//third_party/rules_ml_toolchain:rocm_compiler_rt_fix.patch",
        "//third_party/rules_ml_toolchain:hipcc_wrapper_cxx20.patch",
    ],
    patch_strip = 1,
)

# Hermetic LLVM/ROCm toolchain (sysroot + LLVM repos)
toolchain_ext = use_extension("@rules_ml_toolchain//extensions:toolchain.bzl", "toolchain_ext")
use_repo(toolchain_ext, "llvm_linux_x86_64", "sysroot_linux_x86_64")

# ROCm hermetic download and HIPCC configuration
rocm_hermetic = use_extension("@rules_ml_toolchain//extensions:rocm_hermetic_download.bzl", "rocm_hermetic_download_ext")
use_repo(rocm_hermetic, "rocm_hermetic_dist")

hipcc_configure = use_extension("@rules_ml_toolchain//extensions:hipcc_configure.bzl", "hipcc_configure_ext")
hipcc_configure.configure(rocm_dist = "@rocm_hermetic_dist//:rocm_root")
use_repo(hipcc_configure, "config_rocm_hipcc")

# Development tools
# Hedron's Compile Commands Extractor for Bazel
# https://github.com/hedronvision/bazel-compile-commands-extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "0e990032f3c5a866e72615cf67e5ce22186dcb97",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    # Replace with the latest commit (https://github.com/hedronvision/bazel-compile-commands-extractor/commits/main).
    # Even better, set up Renovate and let it do the work for you (see "Suggestion: Updates" in README).
)


